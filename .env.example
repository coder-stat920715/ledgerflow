# Copy to .env and change every value before use.
APP_PROFILE=dev
POSTGRES_DB=ledgerflow
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ledgerflow.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
